<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base UI palette, ported 1:1 from Task Master Portable's theme. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#71717A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#18181B" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RingBrush" Color="#A1A1AA" />

    <!-- Status-pill color pairs, used by StatusBrushConverter to unused here; kept with the shared theme. -->
    <SolidColorBrush x:Key="ZincPillBg" Color="#F4F4F5" />
    <SolidColorBrush x:Key="ZincPillFg" Color="#3F3F46" />
    <SolidColorBrush x:Key="BluePillBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="BluePillFg" Color="#1D4ED8" />
    <SolidColorBrush x:Key="GreenPillBg" Color="#DCFCE7" />
    <SolidColorBrush x:Key="GreenPillFg" Color="#15803D" />
    <SolidColorBrush x:Key="PurplePillBg" Color="#F3E8FF" />
    <SolidColorBrush x:Key="PurplePillFg" Color="#7E22CE" />
    <SolidColorBrush x:Key="RedPillBg" Color="#FEE2E2" />
    <SolidColorBrush x:Key="RedPillFg" Color="#B91C1C" />
    <SolidColorBrush x:Key="AmberPillBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="AmberPillFg" Color="#B45309" />
    <SolidColorBrush x:Key="OrangePillBg" Color="#FFEDD5" />
    <SolidColorBrush x:Key="OrangePillFg" Color="#C2410C" />

</ResourceDictionary>
