<Window x:Class="MasterLink.Desktop.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Link" Height="180" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="Value" Margin="0,0,0,8"
                   Foreground="{StaticResource ForegroundBrush}" />
        <TextBox x:Name="ValueBox" Padding="6" FontSize="13" KeyDown="ValueBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                    Width="70" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                    Width="70" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
