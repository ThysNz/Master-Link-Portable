<UserControl x:Class="MasterLink.Desktop.Views.BoardViewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterLink.Desktop.ViewModels">
    <UserControl.Resources>

        <!-- Read-only Command row: Seq, command, purpose, Copy. -->
        <DataTemplate x:Key="ReadCommandTemplate" DataType="{x:Type vm:CommandRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding Seq}" Width="28" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" />
                <TextBlock Text="{Binding Command}" TextWrapping="Wrap" Width="400" FontSize="13" Margin="0,0,8,0" FontFamily="Consolas" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Width="340" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Content="Copy" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyCommandCommand}"
                        VerticalAlignment="Center" ToolTip="Copy the command to the clipboard" />
            </StackPanel>
        </DataTemplate>

        <!-- Read-only Environment row. The password is never shown, only copyable. -->
        <DataTemplate x:Key="ReadEnvTemplate" DataType="{x:Type vm:EnvRowViewModel}">
            <StackPanel Margin="0,2,0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Seq}" Width="28" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Application}" Width="150" FontSize="13" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Path}" Width="240" FontSize="13" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UserName}" Width="120" FontSize="13" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Text="••••••••" Width="120" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedForegroundBrush}" />
                    <Button Content="Copy user" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyUserCommand}"
                            VerticalAlignment="Center" ToolTip="Copy the user name to the clipboard" />
                    <Button Content="Copy pwd" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyPasswordCommand}"
                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Copy the password to the clipboard" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0"
                            Visibility="{Binding Commands.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <Button Content="{Binding CommandsExpanded, Converter={StaticResource ExpandGlyphConverter}}"
                            Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleCommandsCommand}" />
                    <TextBlock Text="Commands" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Commands.Count, StringFormat={}({0})}" Style="{StaticResource MutedTextStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="52,0,0,4" Visibility="{Binding CommandsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="SEQ" Width="28" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        <TextBlock Text="COMMAND" Width="400" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        <TextBlock Text="PURPOSE" Width="340" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource ReadCommandTemplate}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ReadBlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <Border Background="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Expanded, Converter={StaticResource ExpandGlyphConverter}}"
                                Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleExpandedCommand}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="24,8,0,0" Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" Visibility="{Binding Env.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <TextBlock Text="SEQ" Width="28" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="APPLICATION" Width="150" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="PATH" Width="240" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="USER" Width="120" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="PASSWORD" Width="120" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Env}" ItemTemplate="{StaticResource ReadEnvTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReadSystemTemplate" DataType="{x:Type vm:SystemViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Border Background="#E4E4E7" CornerRadius="10,10,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Expanded, Converter={StaticResource ExpandGlyphConverter}}"
                                        Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleExpandedCommand}" />
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Margin="24,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="24,14,16,14">
                        <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource ReadBlockTemplate}" />
                        <StackPanel Visibility="{Binding Notes, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding Notes}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1150" Margin="24,32" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="Boards" Style="{StaticResource LinkButtonStyle}" Command="{Binding GoBackCommand}" />
                    <TextBlock Text=" / " Style="{StaticResource MutedTextStyle}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BoardName}" Style="{StaticResource MutedTextStyle}" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Edit" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding EditCommand}" />
            </Grid>

            <TextBlock Text="{Binding BoardName}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Expand All" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0" Command="{Binding ExpandAllCommand}" />
                <TextBlock Text="·" Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
                <Button Content="Collapse All" Style="{StaticResource LinkButtonStyle}" Command="{Binding CollapseAllCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Detail.Systems}" ItemTemplate="{StaticResource ReadSystemTemplate}" Margin="0,20,0,0" />

            <TextBlock Text="No systems on this board yet." Style="{StaticResource MutedTextStyle}"
                       Visibility="{Binding Detail.Systems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
