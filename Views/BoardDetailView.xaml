<UserControl x:Class="MasterLink.Desktop.Views.BoardDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterLink.Desktop.ViewModels"
             xmlns:beh="clr-namespace:MasterLink.Desktop.Behaviors">
    <UserControl.Resources>

        <!-- One Environment row: Seq # + application + path + user + masked password + actions. -->
        <DataTemplate DataType="{x:Type vm:EnvRowViewModel}">
            <StackPanel Margin="0,2,0,2">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Seq}" Width="28" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" />
                <TextBox Text="{Binding Application, UpdateSourceTrigger=LostFocus}" Width="150" FontSize="13" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                         beh:PlaceholderBehavior.Text="Application..." />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" Width="240" FontSize="13" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                         beh:PlaceholderBehavior.Text="Link or path..." />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=LostFocus}" Width="120" FontSize="13" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                         beh:PlaceholderBehavior.Text="User..." />

                <!-- Masked by default; the plain TextBox takes over while ShowPassword is on. -->
                <Grid Width="120" Margin="0,0,8,0">
                    <PasswordBox FontSize="13" VerticalContentAlignment="Center" Padding="0,2"
                                 Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Transparent"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 beh:PasswordBoxBehavior.BoundPassword="{Binding Password, Mode=TwoWay}"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=LostFocus}" FontSize="13"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                             beh:PlaceholderBehavior.Text="Password..."
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Button Content="Show" Style="{StaticResource LinkButtonStyle}" Command="{Binding TogglePasswordCommand}"
                        Width="34" VerticalAlignment="Center" ToolTip="Show / hide the password" />
                <Button Content="Copy user" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyUserCommand}"
                        Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Copy the user name to the clipboard" />
                <Button Content="Copy pwd" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyPasswordCommand}"
                        Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Copy the password to the clipboard" />
                <Button Content="Open" Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenCommand}"
                        Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Open the link or path" />
                <Button Content="✕" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Remove" />
            </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <Button Content="{Binding CommandsExpanded, Converter={StaticResource ExpandGlyphConverter}}"
                            Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleCommandsCommand}" />
                    <TextBlock Text="Commands" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Commands.Count, StringFormat={}({0})}" Style="{StaticResource MutedTextStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="52,0,0,4" Visibility="{Binding CommandsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2" Visibility="{Binding Commands.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <TextBlock Text="SEQ" Width="28" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        <TextBlock Text="COMMAND" Width="400" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        <TextBlock Text="PURPOSE" Width="340" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Commands}" />
                    <Button Content="+ Add command" Style="{StaticResource AddRowButtonStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" Command="{Binding AddCommandCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One Command row: Seq # + command + purpose + copy + delete. -->
        <DataTemplate DataType="{x:Type vm:CommandRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding Seq}" Width="28" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" Width="400" FontSize="13" Margin="0,0,8,0"
                         FontFamily="Consolas" VerticalContentAlignment="Center"
                         Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                         beh:PlaceholderBehavior.Text="Command..." />
                <TextBox Text="{Binding Purpose, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" Width="340" FontSize="13" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                         beh:PlaceholderBehavior.Text="Purpose..." />
                <Button Content="Copy" Style="{StaticResource LinkButtonStyle}" Command="{Binding CopyCommandCommand}"
                        VerticalAlignment="Center" ToolTip="Copy the command to the clipboard" />
                <Button Content="✕" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Remove" />
            </StackPanel>
        </DataTemplate>

        <!-- One collapsible Block: Environment table + collapsible Commands sub-topic. -->
        <DataTemplate DataType="{x:Type vm:BlockViewModel}">
            <Border Background="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Button Content="{Binding Expanded, Converter={StaticResource ExpandGlyphConverter}}"
                                    Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleExpandedCommand}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" FontSize="13" Width="300"
                                     Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                                     beh:PlaceholderBehavior.Text="Block title" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button Content="Delete block" Style="{StaticResource LinkButtonStyle}" Command="{Binding RequestDeleteCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Confirm delete?" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,4,0" Command="{Binding ConfirmDeleteCommand}" />
                                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="24,8,0,0" Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" Visibility="{Binding Env.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <TextBlock Text="SEQ" Width="28" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="APPLICATION" Width="150" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="PATH" Width="240" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="USER" Width="120" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="PASSWORD" Width="120" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Env}" />
                        <Button Content="+ Add row" Style="{StaticResource AddRowButtonStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" Command="{Binding AddEnvCommand}" />

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One System card. -->
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Border Background="#E4E4E7" CornerRadius="10,10,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Button Content="{Binding Expanded, Converter={StaticResource ExpandGlyphConverter}}"
                                            Style="{StaticResource IconButtonStyle}" Padding="2" Command="{Binding ToggleExpandedCommand}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="Medium" FontSize="15" Width="360"
                                             Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                                             beh:PlaceholderBehavior.Text="System name" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Button Content="Delete" Style="{StaticResource LinkButtonStyle}" Command="{Binding RequestDeleteCommand}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="Confirm delete?" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,4,0" Command="{Binding ConfirmDeleteCommand}" />
                                        <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelDeleteCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" Margin="24,6,0,0"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MaxHeight="40" BorderThickness="0" Background="Transparent"
                                     beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                                     beh:PlaceholderBehavior.Text="Short description of the system..." />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="24,14,16,14">

                        <TextBlock Text="BLOCKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Blocks}" />
                        <Button Content="+ Add block" Style="{StaticResource AddRowButtonStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" Command="{Binding AddBlockCommand}" />

                        <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,16,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" Margin="0" MinHeight="70"
                                 Style="{StaticResource BoxedTextBoxStyle}" FontSize="13"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                                 beh:PlaceholderBehavior.Text="Notes..." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1150" Margin="24,32" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="Boards" Style="{StaticResource LinkButtonStyle}" Command="{Binding GoBackCommand}" />
                    <TextBlock Text=" / " Style="{StaticResource MutedTextStyle}" Margin="4,0" />
                    <TextBlock Text="{Binding BoardName}" Style="{StaticResource MutedTextStyle}" Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Visibility="{Binding ConfirmingDeleteBoard, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Content="Delete Board" Style="{StaticResource LinkButtonStyle}" Command="{Binding RequestDeleteBoardCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Visibility="{Binding ConfirmingDeleteBoard, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Confirm delete board?" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,4,0" Command="{Binding ConfirmDeleteBoardCommand}" />
                    <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelDeleteBoardCommand}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBox Text="{Binding BoardName, UpdateSourceTrigger=LostFocus}" FontSize="22" FontWeight="SemiBold"
                             Style="{StaticResource EditableTextBoxStyle}" beh:TextBoxBehaviors.CommitOnEnterEscapeRevert="True"
                             beh:PlaceholderBehavior.Text="Board name" TextAlignment="Center" />
                    <TextBlock Text="{Binding RenameError}" Foreground="{StaticResource DestructiveBrush}" FontSize="11"
                               TextAlignment="Center"
                               Visibility="{Binding RenameError, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Expand All" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0" Command="{Binding ExpandAllCommand}" />
                    <TextBlock Text="·" Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
                    <Button Content="Collapse All" Style="{StaticResource LinkButtonStyle}" Margin="0,0,16,0" Command="{Binding CollapseAllCommand}" />
                    <Button Content="+ New System" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleNewSystemFormCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="12"
                    Visibility="{Binding ShowNewSystemForm, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewSystemName, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,8,0"
                             Style="{StaticResource BoxedTextBoxStyle}" beh:PlaceholderBehavior.Text="System name" />
                    <Button Content="Create" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Command="{Binding CreateSystemCommand}" />
                    <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelNewSystemCommand}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Systems}" Margin="0,20,0,0" />

            <TextBlock Text="No systems on this board yet." Style="{StaticResource MutedTextStyle}"
                       Visibility="{Binding Systems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
